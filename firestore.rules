// Security Rules for AREARNZONE
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token != null && request.auth.token.email in ['abdurrahman714915@gmail.com', 'admin@arearnzone.com'])
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Config
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && isValidId(configId));
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admin Users List
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Task submissions
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Withdraw requests
    match /withdraws/{withdrawId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Membership upgrade requests
    match /membershipRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Deposit requests
    match /depositRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Financial transactions
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Ad View Logs
    match /adViewLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Withdraw Options
    match /withdrawOptions/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payment Methods
    match /paymentMethods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Membership Plans
    match /membershipPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Social Links
    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Notifications
    match /appNotifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Sell Categories
    match /sellCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sell Items
    match /sellItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store Orders
    match /storeOrders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Telegram verification requests
    match /telegramRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Referral Targets
    match /targets/{targetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Referral Target Completion History
    match /targetHistories/{historyId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Gateway Daily Transaction Logs
    match /gatewayLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // CPA Networks
    match /cpaNetworks/{networkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CPA Conversions
    match /cpaConversions/{conversionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // CPA Transactions
    match /cpaTransactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
